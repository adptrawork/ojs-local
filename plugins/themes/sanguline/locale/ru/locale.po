msgid "plugins.themes.sanguline.name"
msgstr "Модуль «Тема оформления по умолчанию»"

msgid "plugins.themes.sanguline.description"
msgstr "Реализует тему оформления по умолчанию."

msgid "plugins.themes.sanguline.option.typography.label"
msgstr "Типографика"

msgid "plugins.themes.sanguline.option.typography.description"
msgstr "Выберите комбинацию шрифтов, которая подходит для этого журнала."

msgid "plugins.themes.sanguline.option.typography.notoSans"
msgstr ""
"Noto Sans: экранный шрифт, созданный Google для поддержки широкого спектра "
"языков."

msgid "plugins.themes.sanguline.option.typography.notoSerif"
msgstr "Noto Serif: антиква, вариант экранного шрифта от Google с засечками."

msgid "plugins.themes.sanguline.option.typography.notoSerif_notoSans"
msgstr ""
"Noto Serif/Noto Sans: дополняющая друг друга пара с заголовками антиквой и "
"основным текстом, набранным гротеском."

msgid "plugins.themes.sanguline.option.typography.notoSans_notoSerif"
msgstr ""
"Noto Sans/Noto Serif: дополняющая друг друга пара с заголовками гротеском и "
"основным текстом, набранным антиквой."

msgid "plugins.themes.sanguline.option.typography.lato"
msgstr "Lato: популярный современный гротеск."

msgid "plugins.themes.sanguline.option.typography.lora"
msgstr "Lora: широкая антиква, удобная для чтения с экрана."

msgid "plugins.themes.sanguline.option.typography.lora_openSans"
msgstr ""
"Lora/Open Sans: дополняющая друг друга пара с заголовками антиквой и "
"основным текстом, набранным гротеском."

msgid "plugins.themes.sanguline.option.colour.label"
msgstr "Цвет"

msgid "plugins.themes.sanguline.option.colour.description"
msgstr "Выбрать цвет для верхнего колонтитула."

msgid "plugins.themes.sanguline.option.showDescriptionInJournalIndex.option"
msgstr "Показать краткую информацию о журнале на главной странице."

msgid "plugins.themes.sanguline.option.useHomepageImageAsHeader.label"
msgstr "Фоновое изображение верхнего колонтитула"

msgid "plugins.themes.sanguline.option.useHomepageImageAsHeader.description"
msgstr ""
"После загрузки изображения главной страницы отображать его в качестве фона "
"верхнего колонтитула, а не на обычном месте на главной странице."

msgid "plugins.themes.sanguline.option.useHomepageImageAsHeader.option"
msgstr "Показывать изображение главной страницы как фон верхнего колонтитула."

msgid "plugins.themes.sanguline.option.displayStats.label"
msgstr "Настройки отображения статистики использования"

msgid "plugins.themes.sanguline.option.displayStats.none"
msgstr "Не показывать диаграмму статистики использования материала читателю."

msgid "plugins.themes.sanguline.option.displayStats.bar"
msgstr ""
"Использовать столбиковую диаграмму для отображения статистики использования."

msgid "plugins.themes.sanguline.option.displayStats.line"
msgstr "Использовать линейный график для отображения статистики использования."

msgid "plugins.themes.sanguline.displayStats.monthInitials"
msgstr "Янв Фев Мар Апр Май Июн Июл Авг Сен Окт Ноя Дек"

msgid "plugins.themes.sanguline.displayStats.downloads"
msgstr "Скачивания"

msgid "plugins.themes.sanguline.displayStats.noStats"
msgstr "Данные по скачиваниям пока не доступны."
