msgid "plugins.themes.sanguline.name"
msgstr "Standard-Thema"

msgid "plugins.themes.sanguline.description"
msgstr "Dieses grafische Thema stellt das Standard-Thema bereit."

msgid "plugins.themes.sanguline.option.typography.label"
msgstr "Typographie"

msgid "plugins.themes.sanguline.option.typography.description"
msgstr "Wählen Sie eine Font-Kombination, die zur Zeitschrift passt."

msgid "plugins.themes.sanguline.option.typography.notoSans"
msgstr ""
"Noto Sans: Ein von Google gestalteter, rein digitaler Font mit umfangreicher "
"Sprachunterstützung."

msgid "plugins.themes.sanguline.option.typography.notoSerif"
msgstr "Noto Serif: Eine Serifenvariante von Googles rein digitalem Font."

msgid "plugins.themes.sanguline.option.typography.notoSerif_notoSans"
msgstr ""
"Noto Serif/Noto Sans: Eine Kombination aus Serifen-Überschriften und Sans-"
"Serif-Fließtext."

msgid "plugins.themes.sanguline.option.typography.notoSans_notoSerif"
msgstr ""
"Noto Sans/Noto Serif: Eine Kombination aus Sans-Serif-Überschriften und "
"Serifen-Fließtext."

msgid "plugins.themes.sanguline.option.typography.lato"
msgstr "Lato: Ein beliebter, moderner Sans-Serif-Font."

msgid "plugins.themes.sanguline.option.typography.lora"
msgstr "Lora: Ein breiter Serifen-Font, gut für Online-Lesen geeignet."

msgid "plugins.themes.sanguline.option.typography.lora_openSans"
msgstr ""
"Lora/Open Sans: Eine Kombination aus Serifen-Überschriften und Sans-Serif-"
"Fließtext."

msgid "plugins.themes.sanguline.option.colour.label"
msgstr "Farbe"

msgid "plugins.themes.sanguline.option.colour.description"
msgstr "Wählen Sie eine Farbe für den Header."

msgid "plugins.themes.sanguline.option.showDescriptionInJournalIndex.option"
msgstr "Die Zusammenfassung der Zeitschrift auf der Homepage anzeigen."

msgid "plugins.themes.sanguline.option.useHomepageImageAsHeader.label"
msgstr "Header Hintergrundbild"

msgid "plugins.themes.sanguline.option.useHomepageImageAsHeader.description"
msgstr ""
"Wenn ein Homepage-Bild hochgeladen wurde, zeige es im Hintergrund des "
"Headers statt an der üblichen Stelle auf der Homepage."

msgid "plugins.themes.sanguline.option.useHomepageImageAsHeader.option"
msgstr "Zeige das Homepage-Bild als Header Hintergrund."

msgid "plugins.themes.sanguline.option.displayStats.label"
msgstr "Anzeigeoptionen für Nutzungsstatistiken"

msgid "plugins.themes.sanguline.option.displayStats.none"
msgstr "Einreichungsstatistik nicht für Leser/innen anzeigen."

msgid "plugins.themes.sanguline.option.displayStats.bar"
msgstr "Verwenden Sie ein Balkendiagramm zur Anzeige der Nutzerstatistiken."

msgid "plugins.themes.sanguline.option.displayStats.line"
msgstr "Liniendiagramm zur Anzeige der Nutzerstatistiken verwenden."

msgid "plugins.themes.sanguline.displayStats.monthInitials"
msgstr "Jan Feb Mär Apr Mai Jun Jul Aug Sep Okt Nov Dez"

msgid "plugins.themes.sanguline.displayStats.downloads"
msgstr "Downloads"

msgid "plugins.themes.sanguline.displayStats.noStats"
msgstr "Download-Daten sind nocht nicht verfügbar."
